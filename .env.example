# ── 빌드타임 전용 ──────────────────────────────────────────────────────
# NEXT_PUBLIC_* 는 next build 시점에 번들과 standalone 의 server.js 에 그대로
# 구워진다. 컨테이너 런타임에만 넣으면 반영되지 않으므로 빌드 전에 지정할 것.
#
# 앱이 서브 경로에 배포될 때의 prefix (예: /c/who-am-i). 루트 배포면 비워 둡니다.
# 값을 넣으면 /health 를 포함한 모든 경로 앞에 이 prefix 가 붙습니다.
NEXT_PUBLIC_BASE_PATH=

# ── 런타임 ────────────────────────────────────────────────────────────
# 아래 값은 앱 소스가 아니라 .next/standalone/server.js 가 직접 읽습니다.

# 서버 포트 (기본 3000)
PORT=3000

# 바인딩 주소. Docker 는 컨테이너 안에 HOSTNAME 을 컨테이너 ID 로 자동 주입하므로,
# 명시하지 않으면 서버가 0.0.0.0 이 아니라 컨테이너 IP 하나에만 바인딩됩니다.
HOSTNAME=0.0.0.0
